# =====================================================================
#  КАСТОМНЫЙ НЕОНОВЫЙ КОНФИГ NANO (Юзер: mmrtrip)
# =====================================================================

# Включаем автоматическую подсветку синтаксиса из установленного пака
include "/usr/share/nano-syntax-highlighting/*.nanorc"

# --- Удобство и Юзабилити ---
set linenumbers      # ВСЕГДА показывать номера строк слева
set mouse            # ВКЛЮЧИТЬ МЫШКУ! (можно кликать, перемещать курсор и скроллить)
set autoindent       # Умные отступы при переходе на новую строку
set tabsize 4        # Размер табуляции в 4 пробела
set tabstospaces     # Конвертировать табы в пробелы (чтобы конфиги i3 не ломались)
set indicator        # Показывать аккуратный прогресс-бар прокрутки справа
set minibar          # Заменить уродливую нижнюю панель на лаконичную полосу статуса
set nohelp

# --- Неоновое перекрашивание интерфейса ---
# Цвета: magenta (розовый), cyan (бирюза), blue (фиолетовый/синий)
set titlecolor black,magenta   # Верхняя полоса с названием файла
set numbercolor cyan           # Номера строк станут сочными бирюзовыми
set statuscolor white,blue     # Полоса статус-бара снизу
set keycolor magenta          # Подсказки горячих клавиш
set selectedcolor black,cyan   # Цвет выделения текста мышкой

# --- Отвязываем старые дефолтные комбинации ---
unbind ^O main       # Отвязываем старое сохранение (WriteOut)
unbind ^R main       # Отвязываем чтение файла (Read File)
unbind ^W main       # Отвязываем старый поиск (Where Is)
unbind ^X main       # Отвязываем старый выход

# --- Накатываем новые привычные хоткеи ---
bind ^S savefile main  # Сейв на Ctrl + S (как у людей!)
bind ^F whereis main   # Поиск на Ctrl + F
bind ^Q exit main      # Выход на Ctrl + Q
bind ^C copy main      # Копировать выделенное на Ctrl + C
bind ^V paste main     # Вставить на Ctrl + V
bind ^X cut main       # Вырезать на Ctrl + X
bind ^Z undo main      # Отмена на Ctrl + Z
bind ^Y redo main      # Повтор на Ctrl + Y
